3.import random

class Die:
    def __init__(self):
        self.value = None
        self.is_kept = False

    def roll(self):
        if not self.is_kept:
            self.value = random.randint(1, 6)
        return self.value

class DiceCollection:
    def __init__(self, count=5):
        self.dice = [Die() for _ in range(count)]
        self.has_ship = False
        self.has_captain = False
        self.has_crew = False

    def roll_unkept(self):
        for d in self.dice:
            if not d.is_kept:
                d.roll()
        self.evaluate_progress()

    def evaluate_progress(self):
     
        if not self.has_ship:
            for d in self.dice:
                if d.value == 6 and not d.is_kept:
                    d.is_kept = True
                    self.has_ship = True
                    break
        if self.has_ship and not self.has_captain:
            for d in self.dice:
                if d.value == 5 and not d.is_kept:
                    d.is_kept = True
                    self.has_captain = True
                    break
        if self.has_ship and self.has_captain and not self.has_crew:
            for d in self.dice:
                if d.value == 4 and not d.is_kept:
                    d.is_kept = True
                    self.has_crew = True
                    break

    def get_cargo_score(self):
        if not (self.has_ship and self.has_captain and self.has_crew):
            return 0
        return sum(d.value for d in self.dice if not d.is_kept)

    def reset(self):
        for d in self.dice:
            d.is_kept = False
            d.value = None
        self.has_ship = False
        self.has_captain = False
        self.has_crew = False

class Player:
    def __init__(self, name):
        self.name = name
        self.score = 0

class ShipCaptainCrewGame:
    def __init__(self, player_names):
        self.players = [Player(name) for name in player_names]

    def play_turn(self, player, interface):
        collection = DiceCollection(5)
        last_score = 0
        for roll_num in range(1, 4):
            collection.roll_unkept()
            last_score = collection.get_cargo_score()
            interface.display_roll(player, collection.dice, roll_num, last_score)
            if collection.has_ship and collection.has_captain and collection.has_crew:
             
                if roll_num < 3 and not interface.ask_keep_score():
                  
                    for d in collection.dice:
                        if d.value not in (6, 5, 4):
                            d.is_kept = False
                else:
                    break
        player.score = last_score
