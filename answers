class Ball:
    def __init__(self, x, y, vx, vy, radius, color="blue", gravity=9.8, restitution=0.8):
        self.x = x
        self.y = y
        self.vx = vx
        self.vy = vy
        self.radius = radius
        self.color = color
        self.gravity = gravity
        self.restitution = restitution  # Bounciness factor (0 to 1)

    def update(self, dt, floor_y=0, ceiling_y=600, left_x=0, right_x=800):
      
        self.vy -= self.gravity * dt
        
      
        self.x += self.vx * dt
        self.y += self.vy * dt
        
       
        if self.y - self.radius <= floor_y:
            self.y = floor_y + self.radius
            self.vy = -self.vy * self.restitution
            
        
        if self.y + self.radius >= ceiling_y:
            self.y = ceiling_y - self.radius
            self.vy = -self.vy * self.restitution
            
       
        if self.x - self.radius <= left_x or self.x + self.radius >= right_x:
            self.vx = -self.vx * self.restitution



