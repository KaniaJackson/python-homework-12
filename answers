1. import random

class Die:
    """Represents an LCR special die with L, R, C, and dot (no-action) sides."""
    SIDES = ['L', 'R', 'C', '.', '.', '.']
    
    def roll(self):
        return random.choice(self.SIDES)

class Player:
    """Represents an individual player in the LCR game."""
    def __init__(self, name, chips=3):
        self.name = name
        self.chips = chips
        self.left = None  
        self.right = None  

    def __str__(self):
        return f"{self.name} (Chips: {self.chips})"

class Pot:
    """Represents the central pot holding accumulated chips."""
    def __init__(self):
        self.amount = 0

    def add(self, count=1):
        self.amount += count

    def claim(self):
        prize = self.amount
        self.amount = 0
        return prize

class LCRGame:
    """Control engine for the Left Center Right simulation."""
    def __init__(self, player_names):
        self.players = [Player(name) for name in player_names]
        num_players = len(self.players)
        for i in range(num_players):
            self.players[i].left = self.players[(i - 1) % num_players]
            self.players[i].right = self.players[(i + 1) % num_players]
        self.pot = Pot()
        self.die = Die()

    def active_players_count(self):
        return sum(1 for p in self.players if p.chips > 0)

    def get_winner(self):
        survivors = [p for p in self.players if p.chips > 0]
        return survivors[0] if len(survivors) == 1 else None

    def play_turn(self, player):
        if player.chips == 0:
            return 
        
        num_dice = min(player.chips, 3)
        rolls = [self.die.roll() for _ in range(num_dice)]
        
        for r in rolls:
            if r == 'L':
                player.chips -= 1
                player.left.chips += 1
            elif r == 'R':
                player.chips -= 1
                player.right.chips += 1
            elif r == 'C':
                player.chips -= 1
                self.pot.add(1)
          

    def simulate_round(self):
        for player in self.players:
            if self.active_players_count() <= 1:
                break
            self.play_turn(player)

    def run_game(self, callback=None):
        round_num = 1
        while self.active_players_count() > 1:
            self.simulate_round()
            winner = self.get_winner()
            if winner:
                winner.chips += self.pot.claim()
                break
            round_num += 1
        return self.get_winner(), round_num
